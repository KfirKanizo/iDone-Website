---
import { Image } from 'astro:assets';
import { localePath, type Locale, useTranslations } from '@/i18n';
import homeHe from '@/assets/work/boostcoach/home-he.png';
import homeEn from '@/assets/work/boostcoach/home-en.png';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const shot = locale === 'he' ? homeHe : homeEn;
---
<section class="build surface-ink" id="scene-build" data-scene="build" aria-labelledby="build-title">
  <div class="pin" data-pin>
    <div class="container layout">
      <div class="copy">
        <p class="eyebrow">{t.home.build.label}</p>
        <h2 id="build-title"><span class="accent-word">{t.home.build.title}</span> {t.home.build.lead}</h2>
        <ul role="list" class="points list-lines" data-points>
          {t.home.build.points.map((p) => (<li class="point">{p}</li>))}
        </ul>
        <a class="link-arrow" href={localePath(locale, '/services/web')}>{t.home.build.link}<span class="arrow" aria-hidden="true">→</span></a>
      </div>

      <figure class="canvas" data-canvas>
        <div class="phone" aria-hidden="true">
          <div class="screen">
            <div class="blocks" data-blocks>
              <span class="dot-slot caret" data-dot-slot="build" data-dot-handoff><i class="dot-local"></i></span>
              <div class="blk nav" data-blk="0"><i></i><i></i><i></i></div>
              <div class="blk heroblk" data-blk="1"><b></b><b class="short"></b></div>
              <div class="blk card" data-blk="2"></div>
              <div class="blk card" data-blk="3"></div>
              <div class="blk chart" data-blk="4"><i style="--h:40%"></i><i style="--h:70%"></i><i style="--h:55%"></i><i style="--h:90%"></i><i style="--h:65%"></i></div>
              <div class="blk cta" data-blk="5"></div>
            </div>
            <Image src={shot} alt={t.home.build.caption} class="shot" data-shot width={390} densities={[1, 2]} loading="lazy" />
          </div>
        </div>
        <figcaption class="caption muted">{t.home.build.caption}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .pin { min-block-size: 100svh; display: grid; align-items: center; padding-block: var(--site-space-16); }
  .layout { display: grid; gap: var(--site-space-12); align-items: center; }
  .copy { display: grid; gap: var(--site-space-6); }
  .accent-word { color: var(--idone-accent); }
  .points { max-inline-size: 48ch; }
  .point { color: var(--idone-muted); transition: color var(--idone-dur-slow) var(--idone-ease-out); }
  .point.is-on, :global(html.dot-hidden) .point, :global(html:not(.js)) .point { color: var(--idone-ink); }

  .canvas { display: grid; gap: var(--site-space-4); justify-items: center; }
  .phone { inline-size: min(300px, 72vw); aspect-ratio: 390 / 820; border: 1.5px solid var(--idone-ink-500); border-radius: 36px; padding: 10px; background: var(--idone-surface); }
  .screen { position: relative; inline-size: 100%; block-size: 100%; border-radius: 28px; overflow: hidden; background: var(--idone-surface-raised); }
  .blocks { position: absolute; inset: 0; padding: 18px 14px; display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: min-content; gap: 12px; align-content: start; }
  .blk { border: 1.5px solid var(--idone-ink-300); border-radius: 10px; opacity: 0; transform-origin: 0 0; }
  :global(html:not(.js)) .blk, :global(html.dot-hidden) .blk { opacity: 1; }
  .nav { grid-column: 1 / -1; block-size: 28px; display: flex; align-items: center; gap: 8px; padding-inline: 10px; }
  .nav i { inline-size: 22px; block-size: 6px; border-radius: 3px; background: var(--idone-ink-300); }
  .nav i:first-child { inline-size: 10px; block-size: 10px; border-radius: 50%; background: var(--idone-accent); }
  .heroblk { grid-column: 1 / -1; block-size: 96px; padding: 14px; display: grid; gap: 8px; align-content: center; }
  .heroblk b { display: block; block-size: 12px; border-radius: 6px; background: var(--idone-ink-300); }
  .heroblk b.short { inline-size: 60%; opacity: 0.6; }
  .card { block-size: 80px; }
  .chart { grid-column: 1 / -1; block-size: 110px; display: flex; align-items: flex-end; gap: 10px; padding: 14px; }
  .chart i { flex: 1; block-size: var(--h); background: var(--idone-ink-300); border-radius: 4px 4px 0 0; }
  .chart i:nth-child(4) { background: var(--idone-accent); }
  .cta { grid-column: 1 / -1; block-size: 44px; border-radius: 999px; background: var(--idone-accent); border-color: transparent; }
  .caret { position: absolute; inline-size: 14px; block-size: 14px; inset-block-start: 18px; inset-inline-start: 14px; }
  .dot-local { display: block; inline-size: 100%; block-size: 100%; border-radius: 50%; background: var(--idone-accent); opacity: 0; }
  :global(html.dot-hidden) .dot-local { opacity: 1; }
  .shot { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; object-position: top; opacity: 0; }
  :global(html:not(.js)) .shot, :global(html.dot-hidden) .shot { opacity: 1; }
  :global(html:not(.js)) .blocks, :global(html.dot-hidden) .blocks { display: none; }
  .caption { font-size: var(--site-step--1); }
  @media (min-width: 900px) { .layout { grid-template-columns: 1.1fr 0.9fr; } }
</style>
