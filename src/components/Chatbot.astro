---
import { type Locale, useTranslations, localePath } from '@/i18n';
import { SITE } from '@/lib/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const c = t.chat;
---
<div class="chat" data-chat data-locale={locale} data-endpoint={SITE.chatEndpoint} data-lead-endpoint={SITE.formEndpoint}
  data-privacy-version={SITE.privacyVersion} data-lead-from={c.leadFrom}
  data-msg-error={c.error} data-msg-limit={c.limit} data-msg-too-long={c.tooLong} data-msg-required={t.form.required}
  data-msg-email={t.form.invalidEmail} data-msg-phone={t.form.invalidPhone} data-msg-sending={t.form.sending} data-lead-success={c.leadSuccess}
  data-welcome={c.welcome} data-suggestions={JSON.stringify(c.suggestions)} data-consent={t.form.consent}>
  <button class="chat-launcher" type="button" data-chat-open aria-expanded="false" aria-controls="chat-panel" aria-label={c.open}>
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/></svg>
    <span class="chat-launcher-label">{c.title}</span>
  </button>

  <section class="chat-panel" id="chat-panel" role="dialog" aria-modal="false" aria-label={c.title} hidden>
    <header class="chat-head">
      <div>
        <p class="chat-title">{c.title}</p>
        <p class="chat-sub">{c.subtitle}</p>
      </div>
      <div class="chat-head-actions">
        <button class="chat-icon" type="button" data-chat-reset title={c.newChat} aria-label={c.newChat}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
        </button>
        <button class="chat-icon" type="button" data-chat-close aria-label={c.close}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>
    </header>

    <div class="chat-log" data-chat-log role="log" aria-live="polite" tabindex="0"></div>

    <form class="chat-lead" data-chat-lead hidden novalidate>
      <p class="chat-lead-title">{c.leadTitle}</p>
      <p class="chat-lead-text">{c.leadText}</p>
      <p class="chat-hp" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></p>
      <label class="chat-field" data-field><span>{t.form.name}</span><input name="name" type="text" autocomplete="name" required /><em class="chat-err" aria-live="polite"></em></label>
      <label class="chat-field" data-field><span>{t.form.phone}</span><input name="phone" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" required /><em class="chat-err" aria-live="polite"></em></label>
      <label class="chat-field" data-field><span>{t.form.email}</span><input name="email" type="email" inputmode="email" autocomplete="email" dir="ltr" required /><em class="chat-err" aria-live="polite"></em></label>
      <label class="chat-consent"><input type="checkbox" name="marketingConsent" /><span>{t.form.consent}</span></label>
      <p class="chat-privacy">{t.form.privacy} <a href={localePath(locale, '/privacy')}>{t.form.privacyLink}</a></p>
      <div class="chat-lead-actions">
        <button class="chat-btn chat-btn-accent" type="submit" data-lead-submit>{c.leadSubmit}</button>
        <button class="chat-btn" type="button" data-lead-cancel>{c.leadCancel}</button>
      </div>
    </form>

    <form class="chat-compose" data-chat-form autocomplete="off">
      <label class="sr-only" for="chat-input">{c.placeholder}</label>
      <textarea id="chat-input" name="message" rows="1" maxlength="800" placeholder={c.placeholder} data-chat-input></textarea>
      <button class="chat-send" type="submit" data-chat-send aria-label={c.send}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="chat-send-ico"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
    </form>
    <p class="chat-disclosure">{c.disclosure}</p>
  </section>
  <template data-typing>{c.thinking}</template>
</div>

<style is:global>
  .chat { --chat-w: min(392px, calc(100vw - 24px)); position: fixed; inset-block-end: 16px; inset-inline-end: 16px; z-index: 60; font-family: var(--site-font-body); font-size: var(--site-step--1); line-height: 1.5; color: var(--idone-ink); }
  .chat [hidden] { display: none !important; }
  .chat .sr-only { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .chat-launcher { display: inline-flex; align-items: center; gap: var(--site-space-2); min-block-size: 52px; padding-inline: var(--site-space-4) var(--site-space-6); border: 0; border-radius: var(--idone-radius-pill); background: var(--idone-accent); color: var(--idone-on-accent); font: inherit; font-weight: 600; cursor: pointer; box-shadow: 0 8px 24px rgba(14, 26, 43, 0.28); transition: transform var(--idone-dur-fast) var(--idone-ease-out), background-color var(--idone-dur-fast) var(--idone-ease-out); }
  .chat-launcher:hover { background: var(--idone-accent-hover); transform: translateY(-2px); }
  .chat[data-open="true"] .chat-launcher { display: none; }
  @media (max-width: 480px) { .chat-launcher-label { display: none; } .chat-launcher { padding-inline: var(--site-space-4); inline-size: 56px; block-size: 56px; justify-content: center; } }

  .chat-panel { inline-size: var(--chat-w); max-block-size: min(640px, calc(100dvh - 32px)); block-size: min(640px, calc(100dvh - 32px)); display: flex; flex-direction: column; background: var(--idone-surface-raised, var(--idone-surface)); border: 1px solid var(--idone-line); border-radius: var(--idone-radius-md); box-shadow: 0 16px 48px rgba(14, 26, 43, 0.32); overflow: hidden; }
  @media (max-width: 480px) { .chat { inset-block-end: 0; inset-inline: 0; } .chat-panel { inline-size: 100%; block-size: min(88dvh, 640px); border-end-start-radius: 0; border-end-end-radius: 0; } .chat-launcher { position: fixed; inset-block-end: 16px; inset-inline-end: 16px; } }
  .chat-head { display: flex; align-items: center; justify-content: space-between; gap: var(--site-space-3); padding: var(--site-space-3) var(--site-space-4); background: var(--idone-ink-900, #0E1A2B); color: var(--idone-mist-100, #fff); }
  .chat-title { margin: 0; font-family: var(--site-font-display); font-weight: 600; font-size: var(--site-step-0); }
  .chat-sub { margin: 0; opacity: 0.75; font-size: 0.8125rem; }
  .chat-head-actions { display: flex; gap: var(--site-space-1); }
  .chat-icon { display: grid; place-items: center; inline-size: 36px; block-size: 36px; border: 0; border-radius: 50%; background: transparent; color: inherit; cursor: pointer; }
  .chat-icon:hover { background: rgba(255, 255, 255, 0.14); }

  .chat-log { flex: 1; overflow-y: auto; padding: var(--site-space-4); display: flex; flex-direction: column; gap: var(--site-space-3); overscroll-behavior: contain; }
  .chat-msg { max-inline-size: 86%; padding: var(--site-space-2) var(--site-space-3); border-radius: 16px; white-space: pre-wrap; overflow-wrap: anywhere; }
  .chat-msg a { color: inherit; text-decoration: underline; }
  .chat-msg-bot { align-self: flex-start; background: color-mix(in srgb, var(--idone-ink) 7%, transparent); border-end-start-radius: 4px; }
  .chat-msg-user { align-self: flex-end; background: var(--idone-accent); color: var(--idone-on-accent); border-end-end-radius: 4px; }
  .chat-msg-note { align-self: stretch; max-inline-size: none; text-align: center; color: var(--idone-muted); background: none; padding-block: 0; }
  .chat-msg-error { color: var(--site-error); }
  .chat-typing::after { content: ""; display: inline-block; inline-size: 1.2em; text-align: start; animation: chat-dots 1.2s steps(4, end) infinite; }
  @keyframes chat-dots { 0% { content: ""; } 25% { content: "."; } 50% { content: ".."; } 75% { content: "..."; } }
  html[data-motion="reduced"] .chat-typing::after { animation: none; content: "…"; }
  .chat-chips { display: flex; flex-wrap: wrap; gap: var(--site-space-2); }
  .chat-chip { padding: var(--site-space-1) var(--site-space-3); border: 1px solid var(--idone-line); border-radius: var(--idone-radius-pill); background: transparent; color: var(--idone-ink); font: inherit; cursor: pointer; }
  .chat-chip:hover { border-color: var(--idone-accent); color: var(--idone-accent); }

  .chat-compose { display: flex; align-items: flex-end; gap: var(--site-space-2); padding: var(--site-space-3); border-block-start: 1px solid var(--idone-line); }
  .chat-compose textarea { flex: 1; resize: none; max-block-size: 120px; min-block-size: 40px; padding: 9px var(--site-space-3); border: 1px solid var(--idone-line); border-radius: 20px; background: var(--idone-surface); color: var(--idone-ink); font: inherit; }
  .chat-compose textarea:focus-visible { outline: var(--site-focus); outline-offset: 1px; border-color: var(--idone-accent); }
  .chat-send { flex: none; display: grid; place-items: center; inline-size: 40px; block-size: 40px; border: 0; border-radius: 50%; background: var(--idone-accent); color: var(--idone-on-accent); cursor: pointer; }
  .chat-send:hover { background: var(--idone-accent-hover); }
  .chat-send:disabled { opacity: 0.5; cursor: not-allowed; }
  [dir="rtl"] .chat-send-ico { transform: scaleX(-1); }
  .chat-disclosure { margin: 0; padding: 0 var(--site-space-4) var(--site-space-3); color: var(--idone-muted); font-size: 0.75rem; }

  .chat[data-lead="true"] .chat-compose, .chat[data-lead="true"] .chat-disclosure { display: none; }
  .chat-log { min-block-size: 96px; }
  .chat-lead { flex: 0 1 auto; display: grid; gap: var(--site-space-2); padding: var(--site-space-3) var(--site-space-4); border-block-start: 1px solid var(--idone-line); max-block-size: 72%; overflow-y: auto; }
  .chat-lead-title { margin: 0; font-weight: 600; }
  .chat-lead-text, .chat-privacy { margin: 0; color: var(--idone-muted); font-size: 0.8125rem; }
  .chat-hp { position: absolute; inset-inline-start: -9999px; inline-size: 1px; block-size: 1px; overflow: hidden; }
  .chat-field { display: grid; gap: 2px; }
  .chat-field span { font-weight: 600; font-size: 0.8125rem; }
  .chat-field input { min-block-size: 40px; padding-inline: var(--site-space-3); border: 1px solid var(--idone-line); border-radius: var(--idone-radius-sm); background: var(--idone-surface); color: var(--idone-ink); font: inherit; }
  .chat-field input:focus-visible { outline: var(--site-focus); outline-offset: 1px; }
  .chat-field[data-invalid="true"] input { border-color: var(--site-error); }
  .chat-err { font-style: normal; color: var(--site-error); font-size: 0.8125rem; min-block-size: 0; }
  .chat-consent { display: flex; gap: var(--site-space-2); align-items: flex-start; font-size: 0.8125rem; cursor: pointer; }
  .chat-consent input { flex: none; inline-size: 16px; block-size: 16px; margin-block-start: 3px; accent-color: var(--idone-accent); }
  .chat-lead-actions { display: flex; gap: var(--site-space-2); flex-wrap: wrap; }
  .chat-btn { min-block-size: 40px; padding-inline: var(--site-space-4); border: 1.5px solid var(--idone-line); border-radius: var(--idone-radius-pill); background: transparent; color: var(--idone-ink); font: inherit; font-weight: 600; cursor: pointer; }
  .chat-btn:hover { border-color: var(--idone-ink); }
  .chat-btn-accent { background: var(--idone-accent); border-color: var(--idone-accent); color: var(--idone-on-accent); }
  .chat-btn-accent:hover { background: var(--idone-accent-hover); border-color: var(--idone-accent-hover); }
  .chat-btn:disabled { opacity: 0.6; cursor: wait; }
  .chat :focus-visible { outline: var(--site-focus); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .chat-launcher { transition: none; } }
</style>
