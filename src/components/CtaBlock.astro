---
/**
 * The closing block of every page: the mark waits with an empty counter, the form sits next to it,
 * and on a successful send the travelling dot leaps into the D (the brand's own "landed" moment)
 * and the mark plays its tap() micro-animation.
 */
import Logo from './Logo.astro';
import ContactForm from './ContactForm.astro';
import { type Locale, useTranslations } from '@/i18n';
interface Props { locale: Locale; compact?: boolean }
const { locale, compact = false } = Astro.props;
const t = useTranslations(locale);
---
<section class:list={['cta-block section', { compact }]} id="scene-cta" data-scene="cta" aria-labelledby="cta-title">
  <div class="container layout">
    <div class="copy">
      <div class="mark-wrap" data-cta-mark-wrap>
        <!-- --idone-accent: transparent hides the mark's own dot until the travelling dot lands in it -->
        <Logo layout="mark" animation="none" class="cta-mark" id="cta-mark" />
        <span class="dot-slot wait" data-dot-slot="cta" data-dot-scale="1.3" aria-hidden="true"></span>
        <span class="dot-slot counter" data-dot-slot="cta-done" data-dot-scale="0" aria-hidden="true"></span>
      </div>
      <h2 id="cta-title" data-cta-title>{t.ctaBlock.title}</h2>
      <p class="lead" data-cta-sub>{t.ctaBlock.sub}</p>
      <p class="done t-3" data-cta-done hidden>{t.ctaBlock.done}</p>
    </div>
    <div class="form-wrap">
      <ContactForm locale={locale} id={compact ? 'cta-form' : 'contact-form'} />
    </div>
  </div>
</section>

<style>
  .layout { display: grid; gap: var(--site-space-16); align-items: start; }
  .copy { display: grid; gap: var(--site-space-6); align-content: start; position: sticky; inset-block-start: calc(var(--site-header-h) + 24px); }
  .mark-wrap { position: relative; inline-size: clamp(120px, 18vw, 200px); aspect-ratio: 1; direction: ltr; }
  .cta-mark { inline-size: 100%; }
  :global(html.js:not(.dot-hidden)) .cta-mark:not(.is-landed) { --idone-accent: transparent; }
  .wait { position: absolute; inset-block-start: 50%; inset-inline-end: -22%; translate: 0 -50%; inline-size: 16px; block-size: 16px; }
  /* counter centre of the 64-unit mark grid: (32, 32) */
  .counter { position: absolute; inset-inline-start: 50%; inset-block-start: 50%; inline-size: 2px; block-size: 2px; translate: -50% -50%; }
  .done { color: var(--idone-accent); }
  @media (min-width: 900px) { .layout { grid-template-columns: 0.8fr 1.2fr; } }
  @media (max-width: 899px) { .copy { position: static; } }
</style>
